# Chito mobile app (Expo). Copy to .env.
# Only EXPO_PUBLIC_* variables reach the app — they are bundled into the APK,
# so NEVER put secrets here (no Razorpay secret, no DB URI).

# API base URL. On a real phone, "localhost" won't work — use your PC's LAN IP
# (run `ipconfig` → IPv4 Address) and keep phone + PC on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://<your-pc-lan-ip>:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://<your-pc-lan-ip>:4000

# ImageKit URL endpoint (public). App appends transforms, e.g. ?tr=w-300,f-auto
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# Razorpay PUBLIC key id only (rzp_test_... in dev)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_

# Google Maps SDK for Android (Google Cloud Console → restrict to Android app package com.chito.app)
# Read in app.config.ts → android.config.googleMaps.apiKey
GOOGLE_MAPS_ANDROID_API_KEY=

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development

# Chito support number for Call / WhatsApp buttons (with country code, e.g. +919800000000)
EXPO_PUBLIC_SUPPORT_PHONE=
