{
  "expo": {
    "name": "Chito",
    "slug": "chito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chito",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF4E6",
    "ios": {
      "bundleIdentifier": "com.chito.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.chito.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFD60A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B1E28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chito uses your location to check you're within 3 km of Singtam Bazaar and to help our rider find you."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
