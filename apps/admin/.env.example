# Chito admin dashboard (Next.js). Copy to .env.local.
# NEXT_PUBLIC_* values are visible in the browser — no secrets.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ImageKit URL endpoint (public, for previews/thumbnails). Uploads go through the API.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# Google Maps JavaScript API key (store pin + 3 km circle in Settings). Restrict to your admin domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SENTRY_DSN=
