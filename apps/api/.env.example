# Chito backend (Express + MongoDB) — copy to .env and fill in.
# These are SECRETS. Never commit .env, never paste them into the mobile app.

# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated sites allowed to call the API (admin dashboard, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Database: MongoDB Atlas ─────────────────────────────
# Atlas → create free M0 cluster (region: AWS Mumbai ap-south-1) → Database Access: add user
# → Network Access: add your IP → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chito

# ── Login tokens (JWT) ──────────────────────────────────
# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Dashboard sessions end sooner than customer ones
JWT_ADMIN_REFRESH_EXPIRES_IN=7d

# ── OTP SMS: MSG91 ──────────────────────────────────────
# Login is phone number + OTP. While OTP_DEV_MODE=true no SMS is sent and the code is always 1234.
# For real SMS: msg91.com → Auth Key + an OTP template approved on DLT (TRAI rule for India),
# then set OTP_DEV_MODE=false. It MUST be false on the production server.
OTP_DEV_MODE=true
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Payments: Razorpay ──────────────────────────────────
# Dashboard → Account & Settings → API Keys (use Test Mode keys until KYC/launch)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://<api-domain>/api/v1/webhooks/razorpay → set a secret
RAZORPAY_WEBHOOK_SECRET=

# ── Images: ImageKit ────────────────────────────────────
# Dashboard → Developer options → API keys. Private key is server-only.
IMAGEKIT_PUBLIC_KEY=public_
IMAGEKIT_PRIVATE_KEY=private_
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>
IMAGEKIT_FOLDER=/chito

# ── Store defaults (used once by the seed script; admin dashboard is the source of truth after) ──
STORE_NAME=Chito Singtam Bazaar
STORE_ADDRESS=Singtam Bazaar, East Sikkim 737134
STORE_LAT=27.234
STORE_LNG=88.499
SERVICE_RADIUS_KM=3
STORE_OPEN_TIME=06:00
STORE_CLOSE_TIME=22:00
MIN_ORDER_VALUE_PAISE=9900
DELIVERY_FEE_PAISE=2000
FREE_DELIVERY_ABOVE_PAISE=19900
TZ=Asia/Kolkata

# ── First admin account (created once by the seed script) ──
# Use a strong password (12+ chars) — the admin dashboard will be on the internet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional ────────────────────────────────────────────
# expo.dev → Account settings → Access tokens (enables push-notification security)
EXPO_ACCESS_TOKEN=
SENTRY_DSN=

# ── Testing only (ignored when NODE_ENV=production) ──
# Let orders through from anywhere (e.g. testing away from Singtam).
# Accept orders outside store hours.
DEV_IGNORE_STORE_HOURS=false

# Where Razorpay sends the customer back after paying (PC Wi-Fi IP in dev, https API domain in production)
PUBLIC_API_URL=http://<your-pc-lan-ip>:4000
