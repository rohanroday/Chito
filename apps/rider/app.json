{
  "expo": {
    "name": "Chito Rider",
    "slug": "chito-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chitorider",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF4E6",
    "ios": {
      "bundleIdentifier": "com.chito.rider",
      "supportsTablet": false
    },
    "android": {
      "package": "com.chito.rider",
      "adaptiveIcon": {
        "backgroundColor": "#7B1E28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B1E28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chito Rider shares your location with the store and the customer only while you are delivering an order."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b72f7fb1-2b45-4fc8-9054-b1af050e38a5"
      }
    }
  }
}
