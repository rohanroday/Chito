# Chito Rider (Expo). Copy to .env. Only EXPO_PUBLIC_* values: they are bundled into the app, never put secrets here.
# On a real phone use your PC's Wi-Fi IP, or the online server.
EXPO_PUBLIC_API_URL=http://<your-pc-lan-ip>:4000/api/v1
# Store number riders can call from the app (with country code)
EXPO_PUBLIC_SUPPORT_PHONE=
