{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chito-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/mobile", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "chito-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/api", "run", "dev"],
      "port": 4000
    },
    {
      "name": "chito-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/admin", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
