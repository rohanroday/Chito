# Settings for the Chito container. Copy to chito.env, fill in, and pass it when running:
#   docker run -p 4000:4000 --env-file chito.env chito
# chito.env is git-ignored: it holds secrets, never commit it.

# ── Required ──
# MongoDB Atlas connection string (Atlas → Network Access must allow the platform's IP, or 0.0.0.0/0)
MONGODB_URI=
# Two different random strings, at least 32 characters each (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The address people open, exactly as the platform gives it (no trailing slash). Razorpay sends payers back here.
PUBLIC_API_URL=https://chito.example.edu

# ── Online payments (Razorpay test keys are fine for a demo) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Product photo uploads from the dashboard (photos already in the catalogue load without these) ──
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/denzongwater
IMAGEKIT_PRIVATE_KEY=

# ── Already set inside the image (demo mode); uncomment to change ──
# PORT=4000
# NODE_ENV=development          # production refuses OTP_DEV_MODE=true
# OTP_DEV_MODE=true             # OTP is always 1234 (no SMS)
# DEV_IGNORE_STORE_HOURS=true   # orders allowed at any hour
# CORS_ORIGINS=                 # only needed if OTHER websites call this API
